<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TaxiDispatcher.MainWindow"
        Title="Диспетчерская такси" Width="800" Height="600">
    <Grid RowDefinitions="Auto, *" Margin="20">
        <TextBlock Text="Проверка подключения к БД (список пользователей):" FontWeight="Bold" FontSize="20" Margin="0,0,0,10"/>
        <ListBox x:Name="UsersList" Grid.Row="1" />
    </Grid>
</Window>
