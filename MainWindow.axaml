<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TaxiDispatcher.ViewModels"
        x:Class="TaxiDispatcher.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Диспетчерская такси" Width="980" Height="650">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" x:Name="MenuPanel" IsVisible="False" Background="#2C3E50" Padding="10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                    <Button Content="Заказы" Click="OrdersClick" Background="Transparent" Foreground="White" />
                    <Button x:Name="UsersBtn" Content="Пользователи" Click="UsersClick" Background="Transparent" Foreground="White" />
                    <Button x:Name="TariffsBtn" Content="Тарифы" Click="TariffsClick" Background="Transparent" Foreground="White" />
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="ThemeBtn" Click="ThemeClick" Background="Transparent" BorderThickness="0" 
                            ToolTip.ShowDelay="400" ToolTip.Tip="Системная">
                        <PathIcon x:Name="ThemeIcon" Width="22" Height="22" Foreground="White" 
                                  Data="{StaticResource MonitorIcon}"/>
                    </Button>
                    
                    <Button Content="Выход" Click="LogoutClick" Background="#E74C3C" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
