<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:TaxiDispatcher.Models"
             x:Class="TaxiDispatcher.Views.OrdersView"
             x:Name="Root">
    
    <Grid>
        <Grid RowDefinitions="Auto, *">
            <StackPanel Margin="20,20,20,10" Spacing="5">
                <TextBlock Classes="h1" Text="Панель диспетчера: Заказы" Margin="0"/>
                <Grid ColumnDefinitions="Auto, *" Margin="0,10,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Width="250" PlaceholderText="Поиск..." TextChanged="SearchTextChanged"/>
                        <ComboBox x:Name="FilterStatus" Width="150" SelectedIndex="0" SelectionChanged="FilterSelectionChanged">
                            <ComboBoxItem Content="Все статусы" Tag="0"/>
                            <ComboBoxItem Content="Новый" Tag="1"/>
                            <ComboBoxItem Content="В пути" Tag="2"/>
                            <ComboBoxItem Content="Завершён" Tag="3"/>
                        </ComboBox>
                        <ComboBox x:Name="SortOrder" Width="160" SelectedIndex="0" SelectionChanged="FilterSelectionChanged">
                            <ComboBoxItem Content="Сначала новые" Tag="1"/>
                            <ComboBoxItem Content="Сначала старые" Tag="0"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Новый заказ" Click="NewOrderClick" Background="#27AE60" Foreground="White" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
            
            <ScrollViewer Grid.Row="1" Margin="10">
                <ItemsControl x:Name="OrdersList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Order">
                            <Border Classes="card">
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="#6C757D" FontSize="12" VerticalAlignment="Center"/>
                                        
                                        <ComboBox Grid.Column="1" 
                                                  ItemsSource="{Binding #Root.StatusList}" 
                                                  SelectedItem="{Binding Status, Mode=TwoWay}"
                                                  SelectionChanged="OrderStatusChanged"
                                                  Width="130" FontSize="12" Padding="5,2" />
                                    </Grid>
                                    
                                    <TextBlock Text="{Binding ClientName}" FontWeight="Bold" FontSize="16" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding PickupAddress}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding DestinationAddress}" Foreground="#6C757D"/>
                                    <TextBlock Text="{Binding Tariff.TariffName, StringFormat='Тариф: {0}'}" Foreground="#3498DB"/>
                                    <TextBlock Text="{Binding Invoice.Amount, StringFormat='Стоимость: {0:N2} руб.'}" FontWeight="Bold" FontSize="16" Foreground="#27AE60"/>
                                    
                                    <Button Content="Редактировать" Click="EditOrderClick" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ModalOverlay" IsVisible="False" Background="#B0000000">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="12" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <StackPanel>
                    <Border Background="#2C3E50" CornerRadius="12,12,0,0" Padding="20,15">
                        <TextBlock x:Name="ModalTitle" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <StackPanel Margin="25" Spacing="10">
                        <Grid ColumnDefinitions="130, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            
                            <TextBlock Grid.Row="0" Text="ФИО клиента:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ClientNameBox" PlaceholderText="Иванов Иван Иванович" TextChanged="ClientNameTextChanged"/>
                            
                            <TextBlock Grid.Row="1" Text="Телефон:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ClientPhoneBox" PlaceholderText="+7 (999) 123-45-67" Margin="0,5,0,0" TextChanged="ClientPhoneTextChanged"/>
                            
                            <TextBlock Grid.Row="2" Text="Адрес подачи:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="PickupBox" PlaceholderText="Улица, дом, подъезд" Margin="0,5,0,0" TextChanged="PickupTextChanged"/>
                            
                            <TextBlock Grid.Row="3" Text="Куда едем:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="DestinationBox" PlaceholderText="Улица, дом, ориентир" Margin="0,5,0,0" TextChanged="DestinationTextChanged"/>
                            
                            <TextBlock Grid.Row="4" Text="Дистанция (км):" VerticalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="DistanceBox" PlaceholderText="Например: 5.5" Margin="0,5,0,0" TextChanged="DistanceTextChanged"/>

                            <TextBlock Grid.Row="5" x:Name="StatusLabel" Text="Статус:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="StatusBox" HorizontalAlignment="Stretch" Margin="0,5,0,0"/>
                            
                            <TextBlock Grid.Row="6" Text="Тариф:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="TariffBox" PlaceholderText="Выберите тариф" SelectionChanged="TariffSelectionChanged" HorizontalAlignment="Stretch" Margin="0,5,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Tariff">
                                        <TextBlock Text="{Binding TariffName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            
                            <TextBlock Grid.Row="7" Text="Стоимость:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="PriceLabel" FontWeight="Bold" FontSize="18" Foreground="#27AE60" Margin="0,10,0,0"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
                            <Button Content="Отмена" Click="CancelClick"/>
                            <Button Content="Сохранить" Click="SaveClick" Background="#27AE60" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
