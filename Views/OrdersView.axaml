<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:TaxiDispatcher.Models"
             x:Class="TaxiDispatcher.Views.OrdersView">
    
    <Grid>
        <Grid RowDefinitions="Auto, *">
            <Grid ColumnDefinitions="*, Auto, Auto" Margin="20,20,20,10">
                <TextBlock Grid.Column="0" Classes="h1" Text="Панель диспетчера: Заказы" VerticalAlignment="Center" Margin="0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,0,20,0">
                    <Button Content="Новый заказ" Click="NewOrderClick" Background="#27AE60" Foreground="White"/>
                    <Button Content="Обновить" Click="ReloadClick"/>
                </StackPanel>
            </Grid>
            
            <ScrollViewer Grid.Row="1" Margin="10">
                <ItemsControl x:Name="OrdersList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Order">
                            <Border Classes="card">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="#6C757D" FontSize="12"/>
                                    <TextBlock Text="{Binding ClientName}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding ClientPhone}" Foreground="#6C757D"/>
                                    <TextBlock Text="{Binding PickupAddress}" FontWeight="Bold" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding DestinationAddress}" Foreground="#6C757D"/>
                                    <TextBlock Text="{Binding Status.StatusName}" FontWeight="Bold" Foreground="#F39C12" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding DistanceKm, StringFormat='{}Дистанция: {0} км'}" FontSize="14" FontWeight="Bold" Margin="0,5,0,0"/>
                                    
                                    <Button Content="Редактировать" Click="EditOrderClick" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ModalOverlay" IsVisible="False" Background="#B0000000">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                    BorderThickness="0"
                    CornerRadius="12" Padding="0" Width="460" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    BoxShadow="0 15 40 0 #80000000"
                    ClipToBounds="True">
                <StackPanel>
                    <Border Background="#2C3E50" CornerRadius="12,12,0,0" Padding="20,15">
                        <TextBlock x:Name="ModalTitle" Text="Редактирование заказа" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    
                    <StackPanel Margin="25" Spacing="15">
                        <Grid ColumnDefinitions="130, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО клиента:" Foreground="{DynamicResource ThemeForegroundBrush}" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ClientNameBox" Watermark="Иванов Иван" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Телефон:" Foreground="{DynamicResource ThemeForegroundBrush}" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ClientPhoneBox" Watermark="+7 (999) 123-45-67" Margin="0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Адрес подачи:" Foreground="{DynamicResource ThemeForegroundBrush}" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="PickupBox" Watermark="Улица, дом" Margin="0,5"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Куда едем:" Foreground="{DynamicResource ThemeForegroundBrush}" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="DestinationBox" Watermark="Адрес назначения" Margin="0,5"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Дистанция (км):" Foreground="{DynamicResource ThemeForegroundBrush}" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="DistanceBox" Watermark="Например: 5.5" Margin="0,5"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                            <Button Content="Отмена" Click="CancelClick"/>
                            <Button Content="Сохранить" Click="SaveClick" Background="#27AE60" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
