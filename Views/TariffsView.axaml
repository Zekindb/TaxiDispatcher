<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:TaxiDispatcher.Models"
             x:Class="TaxiDispatcher.Views.TariffsView">
    <Grid>
        <Grid RowDefinitions="Auto, *">
            <StackPanel Margin="20,20,20,10" Spacing="5">
                <TextBlock Classes="h1" Text="Управление тарифами" Margin="0"/>
                <Grid ColumnDefinitions="Auto, *" Margin="0,10,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Width="250" PlaceholderText="Поиск по названию тарифа..." TextChanged="SearchTextChanged"/>
                        <ComboBox x:Name="SortOrder" Width="160" SelectedIndex="0" SelectionChanged="FilterSelectionChanged">
                            <ComboBoxItem Content="По названию (А-Я)" Tag="1"/>
                            <ComboBoxItem Content="По названию (Я-А)" Tag="0"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Добавить тариф" Click="AddClick" Background="#27AE60" Foreground="White" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
            
            <ScrollViewer Grid.Row="1" Margin="10">
                <ItemsControl x:Name="TariffsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Tariff">
                            <Border Classes="card">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding TariffName}" FontWeight="Bold" FontSize="18"/>
                                    <TextBlock Text="{Binding CarClass.ClassName, StringFormat='Класс: {0}'}" Foreground="#3498DB"/>
                                    <TextBlock Text="{Binding BaseFare, StringFormat='Подача: {0:N2} руб.'}"/>
                                    <TextBlock Text="{Binding PricePerKm, StringFormat='За км: {0:N2} руб.'}"/>
                                    <TextBlock Text="{Binding MinFare, StringFormat='Минимум: {0:N2} руб.'}" FontWeight="Bold"/>
                                    <Button Content="Изменить" Click="EditClick" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        
        <Grid x:Name="ModalOverlay" IsVisible="False" Background="#B0000000">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="12" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <StackPanel>
                    <Border Background="#2C3E50" CornerRadius="12,12,0,0" Padding="20,15">
                        <TextBlock x:Name="ModalTitle" Text="Тариф" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <StackPanel Margin="25" Spacing="10">
                        <Grid ColumnDefinitions="120, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Text="Название:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" PlaceholderText="Например: Эконом стандарт" TextChanged="NameTextChanged"/>
                            
                            <TextBlock Grid.Row="1" Text="Класс авто:" VerticalAlignment="Center" Margin="0,5"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ClassBox" PlaceholderText="Выберите класс" HorizontalAlignment="Stretch" SelectionChanged="ClassSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:CarClass">
                                        <TextBlock Text="{Binding ClassName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="Подача (руб):" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="BaseFareBox" PlaceholderText="Например: 150.00" TextChanged="BaseFareTextChanged"/>

                            <TextBlock Grid.Row="3" Text="За км (руб):" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="PriceKmBox" PlaceholderText="Например: 25.00" TextChanged="PriceKmTextChanged"/>

                            <TextBlock Grid.Row="4" Text="Минимум (руб):" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="MinFareBox" PlaceholderText="Например: 200.00" TextChanged="MinFareTextChanged"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
                            <Button Content="Отмена" Click="CancelClick"/>
                            <Button Content="Сохранить" Click="SaveClick" Background="#27AE60" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
