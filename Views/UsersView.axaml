<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:TaxiDispatcher.Models"
             x:Class="TaxiDispatcher.Views.UsersView">
    <Grid>
        <Grid RowDefinitions="Auto, *">
            <StackPanel Margin="20,20,20,10" Spacing="5">
                <TextBlock Classes="h1" Text="Управление пользователями" Margin="0"/>
                <Grid ColumnDefinitions="Auto, *" Margin="0,10,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Width="250" PlaceholderText="Поиск по ФИО или логину..." TextChanged="SearchTextChanged"/>
                        <ComboBox x:Name="SortOrder" Width="160" SelectedIndex="0" SelectionChanged="FilterSelectionChanged">
                            <ComboBoxItem Content="По алфавиту (А-Я)" Tag="1"/>
                            <ComboBoxItem Content="По алфавиту (Я-А)" Tag="0"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Добавить пользователя" Click="AddClick" Background="#27AE60" Foreground="White" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
            
            <ScrollViewer Grid.Row="1" Margin="10">
                <ItemsControl x:Name="UsersList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:User">
                            <Border Classes="card">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding Role.RoleName, StringFormat='Роль: {0}'}" Foreground="#3498DB" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Login, StringFormat='Логин: {0}'}"/>
                                    <TextBlock Text="{Binding Phone, StringFormat='Тел: {0}'}" Foreground="#6C757D"/>
                                    <Button Content="Редактировать" Click="EditClick" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ModalOverlay" IsVisible="False" Background="#B0000000">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="12" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <StackPanel>
                    <Border Background="#2C3E50" CornerRadius="12,12,0,0" Padding="20,15">
                        <TextBlock x:Name="ModalTitle" Text="Пользователь" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <StackPanel Margin="25" Spacing="10">
                        <Grid ColumnDefinitions="120, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            
                            <!-- ОДНО ПОЛЕ ДЛЯ ФИО -->
                            <TextBlock Grid.Row="0" Text="ФИО:" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="FullNameBox" PlaceholderText="Иванов Иван Иванович" TextChanged="FullNameTextChanged"/>

                            <TextBlock Grid.Row="1" Text="Логин:" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="LoginBox" PlaceholderText="Введите логин" TextChanged="LoginTextChanged"/>

                            <TextBlock Grid.Row="2" Text="Телефон:" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="PhoneBox" PlaceholderText="+7 (999) 123-45-67" TextChanged="PhoneTextChanged"/>

                            <TextBlock Grid.Row="3" Text="Пароль:" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="PasswordBox" PlaceholderText="Задайте пароль" TextChanged="PasswordTextChanged"/>

                            <TextBlock Grid.Row="4" Text="Роль:" VerticalAlignment="Center" Margin="0,5"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="RoleBox" PlaceholderText="Выберите роль" HorizontalAlignment="Stretch" SelectionChanged="RoleSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Role">
                                        <TextBlock Text="{Binding RoleName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
                            <Button Content="Отмена" Click="CancelClick"/>
                            <Button Content="Сохранить" Click="SaveClick" Background="#27AE60" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
